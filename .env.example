# Copie para ".env" e defina um token aleatório e comprido.
# O token NUNCA vai em config.json -- somente em .env / variável de ambiente.
# É exigido pelo endpoint HTTP de controle /control/promo (fail-closed: sem
# token configurado, o servidor de controle NÃO sobe).
AUTH_TOKEN=troque_por_um_token_aleatorio_bem_comprido_83xx
